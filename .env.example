# OpenAI Configuration (Required)
# Use a key dedicated to this app - per-app keys give clean cost attribution
# and blast-radius isolation across the estate.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Cognito Authentication (REQUIRED for login - see docs/COGNITO_AUTH.md)
COGNITO_USER_POOL_ID=  # e.g. us-east-2_xxxxxxxxx
COGNITO_REGION=us-east-2  # inferred from the pool ID if left blank
COGNITO_CLIENT_ID=  # App client ID for THIS app, on the shared user pool
COGNITO_DOMAIN=  # Hosted UI domain, e.g. your-domain.auth.us-east-2.amazoncognito.com
# The values above also feed the frontend's NEXT_PUBLIC_COGNITO_* build args in
# docker-compose.yml directly - no separate copies needed here.
# Redirects default to http://localhost:8511/... (the published dev port).
# NEXT_PUBLIC_REDIRECT_SIGN_IN=https://knowledge.promethean-labs.co/auth/callback
# NEXT_PUBLIC_REDIRECT_SIGN_OUT=https://knowledge.promethean-labs.co
# This app has no login page of its own - an unauthenticated visitor is
# bounced to the unified login here, then back once signed in.
# NEXT_PUBLIC_HOME_PORTAL_URL=https://home.promethean-labs.co

# Other apps' Cognito App Client IDs trusted to call this API on behalf of
# their own signed-in users, instead of doing a separate username/password
# login against this app (see docs/AI_APP_COGNITO_INTEGRATION.md). Comma
# separated. This app's own COGNITO_CLIENT_ID is always trusted automatically
# - leave this empty until another app is actually ready to forward its
# users' tokens here.
#
# 6ioq8ta0tiipl1t2g9i4hoh1o3 = promethean-document-intelligence's App Client
# (pool us-east-2_CyRy6JBhm), added for its Phase 4b library-wide chat
# feature - see that repo's transformation plan and
# app/services/km_client.py. Forwards the caller's own Cognito access token
# instead of a KM-specific login, same pattern as the "ai" app above.
COGNITO_TRUSTED_CLIENT_IDS=6ioq8ta0tiipl1t2g9i4hoh1o3

# Storage locations
# Defaults write inside the project directory. In Docker these are overridden to
# the mounted volumes (see docker-compose.yml) - do not rely on the defaults in
# a deployment or the data disappears with the container.
VECTOR_DB_PATH=./data/vector_index
USER_DB_PATH=./users.db

# API networking
PORT=8000
API_HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API cross-origin. The
# frontend does NOT need to be listed: it proxies /api/* same-origin through the
# Next rewrite. Leave empty unless a genuine external browser client needs access.
CORS_ORIGINS=

# Security controls
API_KEY_TTL_DAYS=90
PASSWORD_MIN_LENGTH=12
REQUIRE_COMPLEX_PASSWORD=true

# File uploads
# Keep at or below the edge limit (100 MB on Cloudflare's free plan).
MAX_FILE_SIZE_MB=100

# Rate limiting
DEFAULT_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=10/minute
QUERY_RATE_LIMIT=60/minute
MANAGEMENT_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=10/minute

# MCP-specific rate limits (optional, defaults to QUERY_RATE_LIMIT)
# MCP_QUERY_RATE_LIMIT=30/minute    # For query_knowledge and query_corpus tools
# MCP_LIST_RATE_LIMIT=60/minute     # For list_collections and list_corpuses tools
# MCP_RESOURCE_RATE_LIMIT=120/minute  # For resources/read operations

# Performance tuning
EMBEDDING_CONCURRENCY=10      # Max concurrent OpenAI embedding calls
MAX_EMBEDDING_RETRIES=3       # Retry attempts for rate limit errors

# Debug mode. Must be false in production: it also enables a permissive
# localhost CORS regex intended only for local development.
DEBUG=false
LOG_LEVEL=INFO
